{
  "version": "2",
  "name": "TC-10: 自動修復テスト",
  "description": "インポート時の自動修復機能を検証するデータ。(1) outputColsが空のテーブル t2 → インポート時に「結果」列が自動追加される。(2) t1のr2が参照する tableId \"t999\" は存在しない → インポート時に terminal（空outputs）に自動変換される。インポート後にトースト「自動修復を行いました」が表示され、t2に「結果」列が追加されていることを確認する。",
  "entryTableId": "t1",
  "fieldDefs": {
    "f1": {
      "id": "f1",
      "name": "カテゴリ",
      "type": "enum",
      "enumValues": ["A", "B", "C"]
    },
    "f2": {
      "id": "f2",
      "name": "値",
      "type": "number"
    }
  },
  "tables": {
    "t1": {
      "id": "t1",
      "name": "エントリーテーブル",
      "cols": [
        { "id": "c1", "fieldId": "f1" }
      ],
      "outputCols": [
        { "id": "oc1", "name": "振り分け結果" }
      ],
      "rows": [
        {
          "id": "r1",
          "cells": {
            "c1": { "op": "=", "val": "A" }
          },
          "conclusion": { "type": "continue", "tableId": "t2" }
        },
        {
          "id": "r2",
          "cells": {
            "c1": { "op": "=", "val": "B" }
          },
          "conclusion": { "type": "continue", "tableId": "t999" }
        },
        {
          "id": "r3",
          "cells": {},
          "conclusion": {
            "type": "terminal",
            "outputs": { "oc1": "デフォルト" }
          }
        }
      ]
    },
    "t2": {
      "id": "t2",
      "name": "出力列なしテーブル（自動修復対象）",
      "cols": [
        { "id": "c2", "fieldId": "f2" }
      ],
      "outputCols": [],
      "rows": [
        {
          "id": "r4",
          "cells": {
            "c2": { "op": ">=", "val": "100" }
          },
          "conclusion": {
            "type": "terminal",
            "outputs": {}
          }
        },
        {
          "id": "r5",
          "cells": {},
          "conclusion": {
            "type": "terminal",
            "outputs": {}
          }
        }
      ]
    }
  },
  "nField": 3,
  "nTable": 3,
  "nCol": 3,
  "nOCol": 2,
  "nRow": 6
}
