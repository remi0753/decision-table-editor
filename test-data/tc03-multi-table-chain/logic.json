      "outputCols": [{ "id": "oc4", "name": "更新処理" }],
      "rows": [
        {
          "id": "r8",
          "cells": {
            "c3": { "op": ">=", "val": "3" }
          },
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc4": "自動更新 — 書類不要"
            }
          }
        },
        {
          "id": "r9",
          "cells": {
            "c3": { "op": "between", "val": ["1", "2"] }
