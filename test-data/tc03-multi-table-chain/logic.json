      "rows": [
        {
          "id": "r5",
          "cells": {
            "c2": { "op": "=", "val": "false" }
          },
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc2": "承認",
              "oc3": "契約書を送付してください"
            }
          }
        },
        {
          "id": "r6",
          "cells": {
            "c2": { "op": "=", "val": "true" }
          },
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc2": "審査中",
              "oc3": "与信部門にエスカレーションしてください"
            }
          }
        },
        {
          "id": "r7",
          "cells": {},
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc2": "保留",
              "oc3": "延滞歴の確認が必要です"
            }
          }
        }
      ]
    },
    "t3": {
      "id": "t3",
      "name": "更新審査テーブル",
