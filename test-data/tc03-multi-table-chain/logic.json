      "enumValues": ["新規", "更新", "解約"]
    },
    "f2": {
      "id": "f2",
      "name": "契約年数",
      "type": "number"
    },
    "f3": {
      "id": "f3",
      "name": "延滞歴あり",
      "type": "bool"
    },
    "f4": {
      "id": "f4",
      "name": "解約理由",
      "type": "enum",
      "enumValues": ["価格", "機能", "乗り換え", "その他"]
    }
  },
  "tables": {
