          },
          "conclusion": { "type": "continue", "tableId": "t2" }
        },
        {
          "id": "r2",
          "cells": {
            "c1": { "op": "=", "val": "更新" }
          },
          "conclusion": { "type": "continue", "tableId": "t3" }
        },
        {
          "id": "r3",
          "cells": {
            "c1": { "op": "=", "val": "解約" }
          },
          "conclusion": { "type": "continue", "tableId": "t4" }
        },
        {
          "id": "r4",
          "cells": {},
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc1": "不明な申請種別 — 受付窓口へ転送"
            }
          }
        }
      ]
    },
    "t2": {
      "id": "t2",
      "name": "新規審査テーブル",
