        { "id": "oc6", "name": "引き止め施策" }
      ],
      "rows": [
        {
          "id": "r11",
          "cells": {
            "c4": { "op": "=", "val": "価格" }
          },
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc5": "解約受付",
              "oc6": "割引プランを案内してください（最大30%オフ）"
            }
          }
        },
        {
          "id": "r12",
          "cells": {
            "c4": { "op": "=", "val": "機能" }
          },
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc5": "解約受付",
              "oc6": "ロードマップを共有して引き止めを試みてください"
            }
          }
        },
        {
          "id": "r13",
          "cells": {
            "c4": { "op": "in", "val": ["乗り換え", "その他"] }
          },
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc5": "解約受付",
              "oc6": "引き止めなし — 解約手続きを案内してください"
            }
          }
        },
        {
          "id": "r14",
          "cells": {},
          "conclusion": {
            "type": "terminal",
            "outputs": {
              "oc5": "解約受付（理由未入力）",
              "oc6": "理由を確認してください"
            }
          }
        }
      ]
