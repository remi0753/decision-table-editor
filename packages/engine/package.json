{
  "name": "@leverie/engine",
  "version": "0.1.0",
  "description": "Pure, headless decision-logic evaluation engine for LEVERIE.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "leverie",
    "decision-table",
    "decision-engine",
    "dmn",
    "rules-engine",
    "llm",
    "agents"
  ],
  "homepage": "https://github.com/remi0753/leverie/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/remi0753/leverie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remi0753/leverie.git",
    "directory": "packages/engine"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
