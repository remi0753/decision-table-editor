{
  "name": "@leverie/checks",
  "version": "0.1.0",
  "description": "Quality checks for LEVERIE decision tables (duplicates, unreachable rows, contradictions, coverage gaps).",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "leverie",
    "decision-table",
    "validation",
    "linter",
    "static-analysis",
    "dmn"
  ],
  "homepage": "https://github.com/remi0753/leverie/tree/main/packages/checks#readme",
  "bugs": {
    "url": "https://github.com/remi0753/leverie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remi0753/leverie.git",
    "directory": "packages/checks"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@leverie/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
