{
  "name": "leverie",
  "private": true,
  "version": "0.1.0",
  "description": "LEVERIE — Build deterministic decision tools for AI agents, in tables, not code.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=@leverie/editor",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:publishable": "turbo run build --filter='./packages/*' --filter=leverie-mcp",
    "build:local": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
