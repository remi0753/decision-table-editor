# Copy to `.dev.vars` (gitignored). `wrangler dev` loads this file automatically.

# Local: docker-compose neon-proxy + Postgres
DATABASE_URL="postgres://dev:dev@localhost:5432/leverie_dev"

# Random 32+ byte string for session signing.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_ME_WITH_openssl_rand_base64_32"

# API key lookup HMAC key ring. Keep each secret 32+ bytes. Rotate by adding a
# new version under keys and pointing active to it.
HMAC_KEY_RING_JSON='{"active":"v1","keys":{"v1":"REPLACE_ME_WITH_openssl_rand_base64_32"}}'

# Public base URL the SPA uses to reach Better Auth. Local dev points at the
# Vite editor origin so cookies set by /api/auth/verify-email (which is hit
# directly from an email-link redirect) are scoped to the same host the SPA
# later calls /api/* on. Vite proxies /api/* through to the Worker on :8787.
BETTER_AUTH_URL="http://localhost:5173"

# Comma-separated cross-origin callers. Production path-based API normally
# needs no CORS; local Vite dev defaults are allowed when BETTER_AUTH_URL is
# localhost even if this is omitted.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# P3.3 auth providers. Google OAuth works locally when the Google Cloud OAuth
# client has this redirect URI (matches BETTER_AUTH_URL above, which Better
# Auth uses to build the callback URL):
#   http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend is optional for local dev. When RESEND_API_KEY is empty, magic-link
# emails are printed to the Wrangler console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="LEVERIE <auth@leverie.dev>"

# Base64-encoded 32-byte key that encrypts live data-connector credentials
# (database URLs, API tokens) at rest with AES-256-GCM. Required only when you
# create credentialed database/HTTP connectors; when empty, those connectors
# cannot store or decrypt secrets and their resolvers fall back per policy.
# Generate with: openssl rand -base64 32
CONNECTOR_SECRET_KEY=""
