    "@types/dagre": "^0.7.52",
    "@types/node": "^22.15.17",
    "@types/react": "^18.3.18",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
