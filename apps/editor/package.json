{
  "name": "@leverie/editor",
  "private": true,
  "version": "0.1.0",
  "description": "LEVERIE editor — browser-based UI for authoring decision logic.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:bundled": "vite build --mode bundled --outDir dist-bundled --emptyOutDir",
